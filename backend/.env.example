# Database Configuration
DATABASE_URL=postgresql+pg8000://postgres:Root@localhost:5432/sssilksarees

# JWT & Authentication
SECRET_KEY=change_me_to_a_long_random_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cookie Configuration
COOKIE_NAME=ss_access_token
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=True

# Admin Setup Secret (Used for bootstrap initial admin creation)
ADMIN_SETUP_SECRET=ss_super_secret_bootstrap_key_2026

# Third-party Services
STRIPE_SECRET_KEY=sk_test_placeholder

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

